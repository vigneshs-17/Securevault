# SecureVault Environment Configuration

APP_NAME=SecureVault
APP_VERSION=1.0.0
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/securevault

# JWT Authentication
JWT_SECRET_KEY=replace_with_a_strong_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Vault Encryption
VAULT_ENCRYPTION_KEY=replace_with_a_valid_fernet_key

# Audit Integrity
AUDIT_INTEGRITY_KEY=replace_with_a_strong_random_secret_at_least_32_chars

# Host Security
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# CORS
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# API Documentation
DOCS_ENABLED=true